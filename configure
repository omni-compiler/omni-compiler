    tmp_file_c=/tmp/_xmp.$$.c
    tmp_file_x=/tmp/_xmp.$$.x
    echo "int main(){return 0;}" > $tmp_file_c
    chk=`$MPI_CC -lstdc++ $tmp_file_c -o $tmp_file_x 2> /dev/null`
    if test $? -ne 0; then
	rm -f $tmp_file_c $tmp_file_x
	as_fn_error $? "-lstdc++ is not found." "$LINENO" 5
