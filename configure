    chk=`${MPI_FC} --version | head -n1`
    case $chk in
	"GNU Fortran"*)
	    # OPENMP
	    OPENMP_OPT_F="-fopenmp"

	    # XcalableMP
	    XMPF_DEF="-D_XCALABLEMP"

	    # MPI F
	    MPI_FPPFLAGS="-E -cpp"
	    MPI_FCFLAGS="-O2 $OPENMP_OPT_F -fallow-argument-mismatch"
