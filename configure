#--------------------------------------------------------------------
# quad real support

gmpIncOpt=""
gmpDirOpt=""
qRealPrecBits=128

# Check whether --enable-mreal was given.
if test ${enable_mreal+y}
then :
  enableval=$enable_mreal; doQReal=yes
else $as_nop
  doQReal=no
fi


if test "x${doQReal}" = "xyes"; then
    if test -f ${GMP_INCLUDE_DIR}/gmp.h; then
        true
    else
        as_fn_error $? "can't find ${GMP_INCLUDE_DIR}/gmp.h. Please attach --with-gmp=<DIR> or --with-gmp-lib=<DIR>." "$LINENO" 5
    fi

    if ! test -d "$GMP_LIB_DIR"; then
      as_fn_error $? "$GMP_LIB_DIR not found. Please attach --with-gmp=<DIR> or --with-gmp-lib=<DIR>." "$LINENO" 5
    fi

    gmpLibs=`ls ${GMP_LIB_DIR}/libgmp.* 2> /dev/null`
    if test "x${gmpLibs}" = "x"; then
        as_fn_error $? "can't find ${GMP_LIB_DIR}/libgmp.*. Please attach --with-gmp=<DIR> or --with-gmp-lib=<DIR>." "$LINENO" 5
    fi
    gmpIncOpt="-I${GMP_INCLUDE_DIR}"
    gmpLibOpt="-L${GMP_LIB_DIR} -lgmp"
fi


# Check whether --with-precision was given.
if test ${with_precision+y}
then :
  withval=$with_precision; qRealPrecBits=$withval
else $as_nop
  qRealPrecBits=128
fi


# libgmp check
omniLimbT="int"
omniExpT="int"
omniQRealPrecInLimb="1"
omniQRealFillGap=""
if test "x${doQReal}" = "xyes"; then
    omniQPrec=$qRealPrecBits
    printf "%s\n" "#define ENABLE_QREAL 1" >>confdefs.h


    printf "%s\n" "#define OMNI_QREAL_PREC $omniQPrec" >>confdefs.h



    qcCC () {
        rm -f $2 ${2}.*
        ${CC} -I. ${CPPFLAGS} ${CFLAGS} -DENABLE_QREAL ${hasLLFlags} ${gmpIncOpt} $3 $1 -o $2 ${gmpLibOpt}
        if test -x $2; then
            ret=`$2 $4`
            if test "x${ret}" = "x"; then
                as_fn_error $? "can't determine??." "$LINENO" 5
            else
                rm -f $2 ${2}.*
                echo ${ret}
            fi
        else
            as_fn_error $? "can't create check program." "$LINENO" 5
        fi
    }

    # check size of mp_exp_t
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking size of GNU-MP mp_exp_t" >&5
printf %s "checking size of GNU-MP mp_exp_t... " >&6; }
    eSz=`qcCC buildutils/csMPexp.c ./csMPexp`
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: ${eSz}" >&5
printf "%s\n" "${eSz}" >&6; }
    omniExpT=""
    case ${eSz} in
    2)
        omniExpT=${TYPE_INT16};;
    4)
        omniExpT=${TYPE_INT32};;
    8)
        omniExpT=${TYPE_INT64};;
    *)
        as_fn_error $? "can't determine basic type of mp_exp_t ??." "$LINENO" 5
    esac
    printf "%s\n" "#define OMNI_SIZEOF_QEXP_T $eSz" >>confdefs.h



    # check size of mp_limb_t
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking size of GNU-MP mp_limb_t" >&5
printf %s "checking size of GNU-MP mp_limb_t... " >&6; }
    lSz=`qcCC buildutils/csMPlimb.c ./csMPlimb`
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: ${lSz}" >&5
printf "%s\n" "${lSz}" >&6; }
    omniLimbT=""
    case ${lSz} in
    2)
        omniLimbT=${TYPE_INT16};;
    4)
        omniLimbT=${TYPE_INT32};;
    8)
        omniLimbT=${TYPE_INT64};;
    *)
        as_fn_error $? "can't determine basic type of mp_limb_t ??." "$LINENO" 5;;
    esac
    printf "%s\n" "#define OMNI_SIZEOF_QLIM_T $lSz" >>confdefs.h



    # check how many mp_limb_t the GNU-MP needed for N bit precision.
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking how many mp_limb_t needed for $omniQPrec bit precision" >&5
printf %s "checking how many mp_limb_t needed for $omniQPrec bit precision... " >&6; }
    omniQRealPrecInLimb=`qcCC buildutils/cMPlb.c ./cMPlb '' $omniQPrec`
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $omniQRealPrecInLimb" >&5
printf "%s\n" "$omniQRealPrecInLimb" >&6; }
    printf "%s\n" "#define OMNI_QLIM_LEN $omniQRealPrecInLimb" >>confdefs.h



    # check _omQReal_t needs a gap between _mp_exp and _mp_d[omniQRealPrecInLimb].
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking _omQReal_t needs a gap between _mp_exp and _mp_d" >&5
printf %s "checking _omQReal_t needs a gap between _mp_exp and _mp_d... " >&6; }
    gapInByte=`expr $lSz - $eSz`
    subStr=""
    if test ${gapInByte} -gt 0; then
        case ${gapInByte} in
        2)
            # lim == int, exp == short
            subStr="${TYPE_INT16} _gap_;";;
	4)
	    # lim == long long, exp == int
	    subStr="${TYPE_INT32} _gap_;";;
	*)
	    # lim == long long, exp == short

	    subStr="char _gap_[${gapInByte}];"

	    ;;
        esac
    fi
    if test "x${subStr}" != "x"; then
        # TODO
        { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes, put a \"${subStr}\" member in _omQReal_t." >&5
printf "%s\n" "yes, put a \"${subStr}\" member in _omQReal_t." >&6; }
        omniQRealFillGap=${subStr}
        printf "%s\n" "#define OMNI_QREAL_NEED_GAP_MEMBER 1" >>confdefs.h


        printf "%s\n" "#define OMNI_QREAL_GAP_SIZE ${gapInByte}" >>confdefs.h


    else
        omniQRealFillGap="/* if ((sizeof(mp_exp_t) < sizeof(mp_limb_t)), here must be a gap filling member. */"
        { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
printf "%s\n" "no" >&6; }
    fi

    # check libgmp has an mpf_floor(), appeared in gmp3 later.
    oLIBS=${LIBS}
    LIBS="${LIBS} ${gmpLibOpt}"
    oCFLAGS=${CFLAGS}
    CFLAGS="${CFLAGS} ${CPPFLAGS} -DENABLE_QREAL ${gmpIncOpt}"
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking mpf_floor() in $LIBS" >&5
printf %s "checking mpf_floor() in $LIBS... " >&6; }
    hasFloor=no
    cat confdefs.h - <<_ACEOF >conftest.$ac_ext
/* end confdefs.h.  */

        #include "gmp.h"

int
main (void)
{

        mpf_t a;
        mpf_t b;
        (void)mpf_floor(a, b);

  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_link "$LINENO"
then :
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes" >&5
printf "%s\n" "yes" >&6; }; hasFloor=yes
else $as_nop
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
printf "%s\n" "no" >&6; }

fi
rm -f core conftest.err conftest.$ac_objext conftest.beam \
    conftest$ac_exeext conftest.$ac_ext
    LIBS=${oLIBS}
    CFLAGS=${oCFLAGS}
    if test "x${hasFloor}" = "xno"; then
        as_fn_error $? "You have to use gmp3 or later." "$LINENO" 5
    fi
fi










