printf "%s\n" "#define ALIGNOF__BOOL $ac_cv_alignof__Bool" >>confdefs.h



#--------------------------------------------------------------------
# 32/64 bit int type

rm -rf ./szchk ./szchk.*
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: Creating size check program" >&5
printf "%s\n" "Creating size check program" >&6; }
${CC} ${CPPFLAGS} ${CFLAGS} ${hasLLFlags} ./buildutils/szchk.c -o ./szchk
if test ! -x ./szchk; then
        as_fn_error $? "can't create size check program." "$LINENO" 5
fi

F2C_INT64_FLAGS=""
for i in 16 32 64
do
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking $i bit integer" >&5
printf %s "checking $i bit integer... " >&6; }
    typName=`./szchk $i`
    if test "x${typName}" = "xunknown"; then
    case $i in
    16)
        TYPE_INT16="short"

        asump=${TYPE_INT16};;
    32)
        TYPE_INT32="int"

        asump=${TYPE_INT32};;
    64)
        TYPE_INT64="long long int"

        asump=${TYPE_INT64};;
    esac
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: not supported. use $asump" >&5
printf "%s\n" "not supported. use $asump" >&6; }
    else
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $typName" >&5
printf "%s\n" "$typName" >&6; }
    case $i in
    16)
        printf "%s\n" "#define HAS_INT16 1" >>confdefs.h


        TYPE_INT16=${typName}
        ;;
    32)
        printf "%s\n" "#define HAS_INT32 1" >>confdefs.h


        TYPE_INT32=${typName}
        ;;
    64)
        printf "%s\n" "#define HAS_INT64 1" >>confdefs.h


        F2C_INT64_FLAGS="-DAllow_TYQUAD"
        TYPE_INT64=${typName}
        ;;
    esac
    fi
done

rm -rf ./szchk ./szchk.*

