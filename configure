if test "x${ENABLE_UCHARDET} = "xyes""; then
  OPTIONS+=${UCHARDET_PREFIX}
fi

if test "x${doatool}" = "xyes"; then
  OPTIONS+=" --enable-atool"
fi

if test "x${domod2xmod}" = "xyes"; then
  OPTIONS+=" --enable-mod2xmod"
fi

if test "x${dognuext}" = "xyes"; then
  OPTIONS+=" --enable-gnu-extension"
fi

rm -f confdefs.h

echo "--------------------------------------------"
echo "Run configure script in xcodeml-tools."
cd xcodeml-tools
echo ./configure ${OPTIONS} CC="${CC}" CFLAGS="${CFLAGS}"
./configure ${OPTIONS} CC="${CC}" CFLAGS="${CFLAGS}"
if test $? -ne 0; then
   exit 1
fi
